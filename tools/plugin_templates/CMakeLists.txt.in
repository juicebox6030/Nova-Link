cmake_minimum_required(VERSION 3.16)
project(@PREFIX@_plugin VERSION 0.1.0 LANGUAGES C)

find_package(NovaLink 0.1 CONFIG REQUIRED)
add_library(@PREFIX@_plugin src/@PREFIX@_plugin.c)
target_link_libraries(@PREFIX@_plugin PUBLIC NovaLink::nova_link)
target_include_directories(@PREFIX@_plugin PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(@PREFIX@_plugin PUBLIC c_std_99)
set_target_properties(@PREFIX@_plugin PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(@PREFIX@_plugin PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror)
endif()

include(CTest)
if(BUILD_TESTING)
    add_executable(@PREFIX@_smoke examples/smoke.c)
    target_link_libraries(@PREFIX@_smoke PRIVATE @PREFIX@_plugin)
    set_target_properties(@PREFIX@_smoke PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
    if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        target_compile_options(@PREFIX@_smoke PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror)
    endif()
    add_test(NAME @PREFIX@_smoke COMMAND @PREFIX@_smoke)
    option(NOVA_PLUGIN_CONFORMANCE "Build shared plugin contract checks" @CONFORMANCE_DEFAULT@)
    if(NOVA_PLUGIN_CONFORMANCE)
        if(@REQUIREMENT_COUNT@ GREATER @CONFORMANCE_LIMIT@)
            message(FATAL_ERROR "Conformance requires at most @CONFORMANCE_LIMIT@ providers; set NOVA_PLUGIN_CONFORMANCE=OFF")
        endif()
        add_executable(@PREFIX@_conformance examples/conformance.c)
        target_link_libraries(@PREFIX@_conformance PRIVATE @PREFIX@_plugin NovaLink::nova_plugin_conformance)
        set_target_properties(@PREFIX@_conformance PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS NO)
        if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
            target_compile_options(@PREFIX@_conformance PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow -Werror)
        endif()
        add_test(NAME @PREFIX@_conformance COMMAND @PREFIX@_conformance)
    endif()
@FAULT_TESTS@
endif()
